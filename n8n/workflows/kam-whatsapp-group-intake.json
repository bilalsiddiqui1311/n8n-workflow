    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\nconst headers = input.headers || {};\nconst expectedSecret = $env.KAM_INTAKE_SECRET || '';\nconst receivedSecret = headers['x-kam-intake-secret'] || headers['X-Kam-Intake-Secret'] || headers['X-KAM-Intake-Secret'] || '';\n\nif (expectedSecret && receivedSecret !== expectedSecret) {\n  throw new Error('Invalid KAM intake secret');\n}\n\nconst groupName = body.group?.name || 'Unknown group';\nconst senderName = body.sender?.name || body.sender?.number || body.sender?.id || 'Unknown sender';\nconst messageText = body.message?.text || body.message?.rawText || '';\n\nconst kamPrompt = [\n  'KAM Intelligence Chat should process this WhatsApp group message.',\n  '',\n  `Group: ${groupName}`,\n  `Sender: ${senderName}`,\n  `Message: ${messageText}`,\n  '',\n  'Return concise KAM intelligence, risks, actions, and a draft reply if useful.'\n].join('\\n');\n\nreturn [{\n  json: {\n    ...body,\n    kamPrompt,\n    n8nReceivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "Build_KAM_Payload",
      "name": "Build KAM Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CODEX_RUNNER_URL || 'http://host.docker.internal:4777/run'}}",

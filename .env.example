TZ=Asia/Karachi
N8N_PORT=5678
WHATSAPP_BRIDGE_PORT=3001
KAM_INTAKE_SECRET=replace-with-random-hex
KAM_RUNNER_TOKEN=replace-with-random-hex
CODEX_RUNNER_PORT=4777
CODEX_RUNNER_URL=http://host.docker.internal:4777/run
N8N_ENCRYPTION_KEY=replace-with-random-hex
WHATSAPP_GROUP_ID_FILTER=
WHATSAPP_GROUP_NAME_FILTER=
WHATSAPP_COMMAND_PREFIX=#kam
KAM_CODEX_MODEL=
KAM_CODEX_CWD=/absolute/path/to/N8n-local/kam-workspace
KAM_CODEX_TIMEOUT_MS=300000
PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
WHATSAPP_AUTH_DATA_PATH=/absolute/path/to/N8n-local/.runtime/whatsapp-bridge-auth
N8N_USER_FOLDER=/absolute/path/to/N8n-local/.runtime/n8n-user
LOCAL_NODE_BIN=/absolute/path/to/node
LOCAL_NPM_CLI=/absolute/path/to/npm-cli.js
